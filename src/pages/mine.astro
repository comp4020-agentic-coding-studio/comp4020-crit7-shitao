---
import { listBookingsByOwner, listRooms } from "../lib/db";
import { OWNER_COOKIE } from "../lib/owner";
import { BOOKING_WINDOW_DAYS, SLOTS, addDays, today } from "../lib/slots";
import "../styles.css";

// The grid only ever shows one date at a time, so finding a booking you
// already made means clicking through up to fourteen date pages — this is
// the same owner token the cancel button already trusts, read across the
// whole window instead of one date.
const token = Astro.cookies.get(OWNER_COOKIE)?.value;
const myBookings = token ? listBookingsByOwner(token, today()) : [];
const rooms = listRooms();
const roomName = (roomId: number) => rooms.find((room) => room.id === roomId)?.name ?? `room ${roomId}`;
const minDate = today();
const maxDate = addDays(minDate, BOOKING_WINDOW_DAYS);

const error = Astro.url.searchParams.get("error");
const bookingIdParam = Astro.url.searchParams.get("booking");
const erroredBookingId = bookingIdParam ? Number(bookingIdParam) : null;
// A "booking" param names which row an error belongs to, but that row might
// not be in myBookings at all (already gone, or a request sent without the
// matching owner cookie) — fall back to the page-level banner whenever the
// named booking isn't actually one we're about to render.
const matchedBookingId = erroredBookingId && myBookings.some((b) => b.id === erroredBookingId) ? erroredBookingId : null;

const errorMessage = (err: string | null) => {
  switch (err) {
    case "cancel":
      return "Couldn't cancel that booking — it may already be gone.";
    case "notfound":
      return "Couldn't find that booking to move — it may already be gone.";
    case "taken":
      return "Someone booked that slot already — pick another.";
    case "missing":
      return "Room, date and slot are all required to move a booking.";
    case "date":
      return "That date isn't bookable — pick one within the next two weeks.";
    default:
      return null;
  }
};
const message = errorMessage(error);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My bookings — Study rooms</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Study rooms</a>
      <a href="/mine/">My bookings</a>
      <a href="/search/">Search</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>My bookings</h1>
      {message && !matchedBookingId && <p role="alert">{message}</p>}
      {myBookings.length === 0 ? (
        <p>
          Nothing booked from today onward yet, on this browser — bookings only show up here on the browser and
          device you made them from.
        </p>
      ) : (
        <ul class="mine-list">
          {myBookings.map((booking) => (
            <li>
              {message && matchedBookingId === booking.id && <p role="alert">{message}</p>}
              <span>
                <a href={`/?date=${booking.date}`}>{booking.date}</a>, {booking.slot}, {roomName(booking.roomId)} —
                booked by {booking.bookedBy}
              </span>
              <form method="post" action={`/api/bookings/${booking.id}/cancel`}>
                <input type="hidden" name="returnTo" value="/mine/" />
                <button type="submit">Cancel</button>
              </form>
              <details>
                <summary>Move</summary>
                <p>If the new time's already taken, this booking stays where it is.</p>
                <form method="post" action={`/api/bookings/${booking.id}/move`}>
                  <input type="hidden" name="returnTo" value="/mine/" />
                  <span class="field">
                    <label for={`move-room-${booking.id}`}>Room</label>
                    <select id={`move-room-${booking.id}`} name="roomId">
                      {rooms.map((room) => (
                        <option value={room.id} selected={room.id === booking.roomId}>
                          {room.name}
                        </option>
                      ))}
                    </select>
                  </span>
                  <span class="field">
                    <label for={`move-date-${booking.id}`}>Date</label>
                    <input
                      id={`move-date-${booking.id}`}
                      type="date"
                      name="date"
                      value={booking.date}
                      min={minDate}
                      max={maxDate}
                      required
                    />
                  </span>
                  <span class="field">
                    <label for={`move-slot-${booking.id}`}>Slot</label>
                    <select id={`move-slot-${booking.id}`} name="slot">
                      {SLOTS.map((slot) => (
                        <option value={slot} selected={slot === booking.slot}>
                          {slot}
                        </option>
                      ))}
                    </select>
                  </span>
                  <button type="submit">Save</button>
                </form>
              </details>
            </li>
          ))}
        </ul>
      )}
    </main>
  </body>
</html>
